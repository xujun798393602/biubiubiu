# TDD Auto Platform Environment Configuration

# ====================
# Database Configuration
# ====================
POSTGRES_PASSWORD=postgres

# ====================
# Redis Configuration
# ====================
REDIS_URL=redis://redis:6379/0

# ====================
# Backend Configuration
# ====================
JWT_SECRET_KEY=change-this-in-production
DEBUG=false

# ====================
# Worker Configuration
# ====================
# API key for worker authentication (generated when creating nodes)
WORKER_API_KEY=

# Worker heartbeat interval (seconds)
HEARTBEAT_INTERVAL=10

# Playwright Worker Settings
PLAYWRIGHT_MAX_CONCURRENT=3
PLAYWRIGHT_CPU_LIMIT=2
PLAYWRIGHT_MEMORY_LIMIT=4G

# Locust Worker Settings
LOCUST_MAX_CONCURRENT=5
LOCUST_CPU_LIMIT=4
LOCUST_MEMORY_LIMIT=8G

# Mixed Worker Settings
MIXED_MAX_CONCURRENT=5
MIXED_CPU_LIMIT=4
MIXED_MEMORY_LIMIT=8G

# Worker index (for running multiple instances)
WORKER_INDEX=1
