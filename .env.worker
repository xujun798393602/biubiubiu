# Worker 节点配置文件
# 复制此文件为 .env.worker 并修改配置

# ============================================
# Locust Worker 配置
# ============================================
# Locust Worker 的 API Key（在节点管理界面添加节点后获取）
LOCUST_WORKER_API_KEY="747907a66b443dc7400b6ee05632bc227ad162f3825591628e4301bdfd0638cc"

# Locust 最大并发任务数
LOCUST_MAX_CONCURRENT=5

# Locust CPU 限制
LOCUST_CPU_LIMIT=4

# Locust 内存限制
LOCUST_MEMORY_LIMIT=8G

# ============================================
# Playwright Worker 配置
# ============================================
# Playwright Worker 的 API Key（在节点管理界面添加节点后获取）
PLAYWRIGHT_WORKER_API_KEY="fd42951b96fa3878903cbde8e4ec24ee113f3716271f25836cbe3bfafe3993bc"

# Playwright 最大并发任务数
PLAYWRIGHT_MAX_CONCURRENT=3

# Playwright CPU 限制
PLAYWRIGHT_CPU_LIMIT=2

# Playwright 内存限制
PLAYWRIGHT_MEMORY_LIMIT=4G
