# Worker 节点配置文件
# 复制此文件为 .env.worker 并修改配置
# 注意：API Key 值必须用双引号包裹

# ============================================
# Locust Worker 配置
# ============================================
# Locust Worker 的 API Key（在节点管理界面添加节点后获取）
LOCUST_WORKER_API_KEY="your_locust_api_key_here"

# Locust 最大并发任务数
LOCUST_MAX_CONCURRENT=5

# Locust CPU 限制
LOCUST_CPU_LIMIT=4

# Locust 内存限制
LOCUST_MEMORY_LIMIT=8G

# ============================================
# Playwright Worker 配置
# ============================================
# Playwright Worker 的 API Key（在节点管理界面添加节点后获取）
PLAYWRIGHT_WORKER_API_KEY="your_playwright_api_key_here"

# Playwright 最大并发任务数
PLAYWRIGHT_MAX_CONCURRENT=3

# Playwright CPU 限制
PLAYWRIGHT_CPU_LIMIT=2

# Playwright 内存限制
PLAYWRIGHT_MEMORY_LIMIT=4G
